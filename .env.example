# Velnox — environment template.
# Copy to .env.local and fill with real values. NEVER commit real secrets;
# only this placeholder template is tracked. See LAUNCH_CHECKLIST.md for how to
# obtain each production value.

# ── Database (Supabase Postgres) ────────────────────────────────────────────
# Transaction pooler (port 6543) for the app runtime:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"
# Direct connection (port 5432) — used by `prisma migrate` only:
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── AI provider (Gemini AI Studio free tier by default) ─────────────────────
GEMINI_API_KEY="your-ai-studio-key"
# Optional overrides:
GEMINI_MODEL="gemini-2.5-flash"
AI_PROVIDER="auto"            # auto | gemini | local
AI_EMBEDDING_MODEL="gemini-embedding-001"

# ── Google OAuth + Gmail ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/gmail/callback"
# The single mailbox that builds/receives the weekly digest + alert emails.
# Must equal the connected Gmail address, not your login email.
GMAIL_USER_EMAIL="you@yourdomain.com"

# ── Gmail push (Pub/Sub) — optional; falls back to cron polling if unset ─────
GMAIL_PUBSUB_TOPIC="projects/your-project/topics/your-topic"
GMAIL_PUBSUB_VERIFICATION_TOKEN="a-shared-token"

# ── Auth / app ──────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="a-long-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Required in production: AES-256-GCM key that encrypts OAuth tokens at rest.
TOKEN_ENCRYPTION_KEY="a-32-byte-random-key"

# ── Cron / worker secrets ───────────────────────────────────────────────────
CRON_SECRET="a-random-cron-bearer-token"
WORKER_SECRET="a-random-worker-secret"

# ── Billing (Polar.sh) ──────────────────────────────────────────────────────
POLAR_ACCESS_TOKEN="polar_oat_..."
POLAR_WEBHOOK_SECRET="polar_whs_..."
POLAR_SERVER="sandbox"        # sandbox | production
POLAR_PRODUCT_PRO_MONTHLY="prod_..."
POLAR_PRODUCT_PRO_ANNUAL="prod_..."
POLAR_PRODUCT_TEAM_MONTHLY="prod_..."
POLAR_PRODUCT_TEAM_ANNUAL="prod_..."
POLAR_PRODUCT_BUSINESS_MONTHLY="prod_..."
POLAR_PRODUCT_BUSINESS_ANNUAL="prod_..."

# ── Product analytics (PostHog) — optional; app runs fine without it ────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
