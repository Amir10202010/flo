generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  createdAt    DateTime      @default(now())
  integrations Integration[]
  conversations Conversation[]
  contacts     Contact[]
  riskAlerts   RiskAlert[]
  emailDigests EmailDigest[]
  categoryRules CategoryRule[]
  reminders    Reminder[]
  contactNotes ContactNote[]
  memberships  Membership[]
}

/// The tenant. Everything a team owns hangs off an Organization. A user joins one
/// or more orgs via Membership; the connected mailboxes become shared Inboxes.
model Organization {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  createdAt    DateTime      @default(now())
  memberships  Membership[]
  invitations  Invitation[]
  inboxes      Inbox[]
  subscription Subscription?
}

/// A user's seat in an organization, with a role. The unit billing counts as a seat.
model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole        @default(MEMBER)
  status         MemberStatus   @default(ACTIVE)
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  assigned       Conversation[] @relation("ConversationAssignee")

  @@unique([organizationId, userId])
  @@index([userId])
}

/// A pending invite to join an org at a given role. Accepting it creates a Membership.
model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           OrgRole      @default(MEMBER)
  token          String       @unique
  status         InviteStatus @default(PENDING)
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

/// A shared mailbox owned by the organization (support@, sales@, hello@). The
/// Integration holds the OAuth tokens that power it; conversations belong to it.
model Inbox {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  address        String
  channel        ChannelEnum    @default(GMAIL)
  color          String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration    Integration?
  conversations  Conversation[]

  @@unique([organizationId, address])
}

model Integration {
  id           String      @id @default(cuid())
  userId       String
  type         IntegrationTypeEnum
  accessToken  String
  refreshToken String?
  metadata     Json        @default("{}")
  /// Connected mailbox address (lowercased). Denormalized out of `metadata` so
  /// the Gmail push webhook can resolve the integration on an index instead of
  /// a full-table JSON scan (`metadata->>'email'`). Nullable for legacy rows;
  /// `integrationEmail()` falls back to metadata until they're backfilled.
  email        String?
  isActive     Boolean     @default(true)
  syncedAt     DateTime?
  createdAt    DateTime    @default(now())
  /// Tenant + shared-inbox wiring (organization-first). `organizationId` is the
  /// denormalized tenant key; `inboxId` is the shared mailbox this connection
  /// powers (1:1); `connectedById` records which member connected it.
  organizationId String?
  inboxId        String?  @unique
  connectedById  String?
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  inbox        Inbox?      @relation(fields: [inboxId], references: [id])
  conversations Conversation[]

  @@unique([userId, type])
  @@index([email])
  @@index([organizationId])
}

model Contact {
  id          String    @id @default(cuid())
  userId      String
  organizationId String?
  name        String
  email       String?
  telegramId  String?
  phone       String?
  source      ChannelEnum
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  notes       ContactNote[]

  @@unique([userId, telegramId])
  @@unique([userId, email])
  @@index([userId])
  @@index([organizationId])
}

/// A free-text note about a contact, created by the assistant's create_note
/// action (review-before-save: the user confirms the proposed note) or manually
/// on /clients. Recalled in the assistant briefing so it can answer "what do I
/// know about X".
model ContactNote {
  id        String   @id @default(cuid())
  userId    String
  organizationId String?
  contactId String
  body      String
  source    String   @default("assistant") // assistant | manual
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([userId, contactId, createdAt])
  @@index([organizationId])
}

model Conversation {
  id             String        @id @default(cuid())
  userId         String
  organizationId String?
  inboxId        String?
  assigneeId     String?
  contactId      String
  integrationId  String
  channel        ChannelEnum
  externalId     String
  subject        String?
  status         ConversationStatus @default(ACTIVE)
  /// Shared-inbox queue workflow, orthogonal to `status`: a thread can be OPEN
  /// (queue) and ACTIVE (lifecycle) at once. Set CLOSED when archived/lost.
  state          ConversationState @default(OPEN)
  priority       PriorityLevel @default(COLD)
  priorityScore  Float         @default(0)
  category       EmailCategory @default(PRIMARY)
  /// Provenance of `category`: 'rules' | 'ai' | 'manual'. Manual wins and is
  /// never overwritten by automatic (re)classification.
  categorySource String?
  lastMessageAt  DateTime?
  lastAnalyzedAt DateTime?
  /// Denormalized: the latest message is INBOUND (client is awaiting our reply).
  /// Maintained on sync and on reply so server-side filtering/sorting can use a
  /// real index instead of inspecting the latest message per row.
  awaitingReply  Boolean       @default(false)
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact        Contact       @relation(fields: [contactId], references: [id])
  integration    Integration   @relation(fields: [integrationId], references: [id])
  inbox          Inbox?        @relation(fields: [inboxId], references: [id])
  assignee       Membership?   @relation("ConversationAssignee", fields: [assigneeId], references: [id])
  messages       Message[]
  analysis       ConversationAnalysis?
  embedding      ConversationEmbedding?
  draft          ConversationDraft?
  riskAlerts     RiskAlert[]
  internalNotes  InternalNote[]
  tags           ConversationTag[]

  @@unique([integrationId, externalId])
  @@index([userId, priorityScore(sort: Desc), lastMessageAt(sort: Desc)])
  @@index([userId, category])
  @@index([userId, awaitingReply])
  @@index([organizationId, state])
  @@index([organizationId, assigneeId])
  @@index([organizationId, inboxId])
}

/// Team-internal comment on a conversation (visible only to the org, never sent
/// to the contact). Distinct from ContactNote, which is about a person.
model InternalNote {
  id             String       @id @default(cuid())
  organizationId String
  conversationId String
  authorId       String
  body           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([organizationId])
}

/// Org-scoped colored label applied to conversations for filtering/triage.
model Tag {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  color          String            @default("#6366F1")
  createdAt      DateTime          @default(now())
  conversations  ConversationTag[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ConversationTag {
  conversationId String
  tagId          String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag            Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
  @@index([tagId])
}

/// Learned / custom email-routing rule. Created when the user manually moves a
/// thread to a category (matchType 'email', source 'manual') so future mail
/// from that sender auto-classifies; honored ahead of every heuristic by the
/// classifier. Domain-level rules ('domain') are supported for completeness.
model CategoryRule {
  id        String        @id @default(cuid())
  userId    String
  organizationId String?
  matchType String        // 'email' | 'domain'
  value     String        // lowercased sender email or domain
  category  EmailCategory
  source    String        @default("manual") // 'manual' (learned) | 'custom'
  hits      Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, matchType, value])
  @@index([userId])
  @@index([organizationId])
}

/// A team routing/automation rule (organization-first). Conditions over inbound
/// mail (inbox/from/domain/subject keyword/channel) trigger actions (assign a
/// member, add a tag, set priority, set category, close). Applied in the inbound
/// sync pipeline; ordered, toggleable. Distinct from CategoryRule (classifier).
model Rule {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isActive       Boolean  @default(true)
  order          Int      @default(0)
  conditions     Json     @default("{}")
  actions        Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, isActive, order])
}

/// Org-scoped saved reply / snippet inserted in the composer.
model Template {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  body           String
  shared         Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

/// Append-only record of who did what in the organization (member/role changes,
/// inbox connect/disconnect, assignment, state change, rule/template/tag CRUD,
/// billing, settings). `actorId` is null for system/automation actions.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  targetType     String?
  targetId       String?
  summary        String
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

/// One billing subscription per organization. The plan/seat model + feature
/// gates live in code (src/lib/billing.ts); `externalCustomerId` links to the
/// external checkout provider (Stripe-ready) — no payment processor in-app.
model Subscription {
  id                 String       @id @default(cuid())
  organizationId     String       @unique
  plan               BillingPlan  @default(FREE)
  status             String       @default("active")
  seats              Int          @default(1)
  externalCustomerId String?
  currentPeriodEnd   DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  externalId     String?
  direction      MessageDirection
  content        String
  contentHtml    String?
  contentType    ContentType @default(TEXT)
  sentAt         DateTime
  isRead         Boolean     @default(false)
  createdAt      DateTime    @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, externalId])
  @@index([conversationId, sentAt])
}

model ConversationAnalysis {
  id             String    @id @default(cuid())
  conversationId String    @unique
  summary        String
  riskLevel      RiskLevel @default(LOW)
  riskReasons    String[]
  nextAction     String?
  lostReason     String?
  sentiment      Sentiment @default(NEUTRAL)
  analysisData   Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

/// AI-generated reply draft awaiting the user's review (review-before-send — the
/// draft is NEVER auto-sent). One latest draft per conversation; auto-drafts for
/// urgent awaiting threads are produced by the GENERATE_DRAFT job, interactive
/// drafts come straight from the /draft endpoint.
model ConversationDraft {
  id               String   @id @default(cuid())
  conversationId   String   @unique
  userId           String
  organizationId   String?
  body             String
  tone             String   @default("WARM")    // WARM | CONCISE | FORMAL | MATCH
  provider         String   @default("gemini")  // gemini | local
  model            String?
  /// The inbound message this draft answers — used to detect staleness.
  basedOnMessageId String?
  status           String   @default("READY")   // READY | DISMISSED | SENT | STALE
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([organizationId])
}

/// Durable background-job queue. Polled by the sync/ingestion worker
/// (src/worker.ts) and the cron-driven drain endpoint (/api/jobs/process).
/// Claimed atomically via SELECT ... FOR UPDATE SKIP LOCKED.
model Job {
  id          String    @id @default(cuid())
  type        JobType
  status      JobStatus @default(PENDING)
  userId      String?
  payload     Json      @default("{}")
  result      Json?
  error       String?
  /// Collapse key for not-yet-started work, e.g. "GMAIL_SYNC:<userId>" or
  /// "EMBED_CONVERSATION:<conversationId>". A PARTIAL UNIQUE index
  /// (WHERE status = 'PENDING') — created in the migration, not expressible in
  /// the Prisma schema — makes concurrent enqueues race-free: the loser hits a
  /// unique violation and the helper returns the existing PENDING job.
  dedupeKey   String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAfter    DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAfter])
  @@index([userId])
}

/// Centralized fixed-window rate-limit counters. Lives in Postgres (not an
/// in-memory map) so the limit holds across every serverless instance/region.
/// One row per (identity + route + window); `consumeRateLimit` increments it
/// atomically via an upsert. Stale rows are pruned by the daily maintenance cron.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

/// Semantic-search vector for one conversation. The embedding is stored as a
/// packed Float32Array (Bytes) and scored in-process — at the current scale
/// (hundreds of threads) this beats the operational cost of pgvector, and the
/// storage shape can be swapped later without touching the search service API.
model ConversationEmbedding {
  id             String   @id @default(cuid())
  conversationId String   @unique
  model          String
  dims           Int
  vector         Bytes
  /// sha256 of the embedded text — skip re-embedding unchanged conversations.
  contentHash    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

/// Persistent, deduplicated risk alert produced by the alert engine
/// (rules over workspace data + AI analysis output). dedupeKey keeps one
/// row per (user, rule, subject); scans upsert it idempotently.
model RiskAlert {
  id              String      @id @default(cuid())
  userId          String
  organizationId  String?
  conversationId  String?
  type            String
  severity        RiskLevel
  status          AlertStatus @default(OPEN)
  title           String
  reason          String
  suggestedAction String?
  dedupeKey       String      @unique
  firstSeenAt     DateTime    @default(now())
  lastSeenAt      DateTime    @default(now())
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  /// 'user' (manual) or 'auto' (condition cleared) — manual resolves get a
  /// reopen cooldown so the scanner doesn't immediately undo the user.
  resolvedBy      String?
  /// When this alert was last included in a sent notification email. Urgent
  /// alerts are notified exactly once: a fresh row (or a reopened one, which
  /// clears this) qualifies; refreshed rows do not re-notify.
  notifiedAt      DateTime?
  /// Suppress the alert (and its notifications) until this time. Set by the
  /// "snooze" user action; while active the alert is hidden from the OPEN list.
  snoozedUntil    DateTime?
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([organizationId, status])
}

/// A user-set follow-up reminder ("remind me to message X on Friday"), created
/// by the assistant's create_reminder action. Surfaced in the proactive
/// notification email and on the dashboard when due; firedAt guards against
/// surfacing the same reminder twice.
model Reminder {
  id             String   @id @default(cuid())
  userId         String
  organizationId String?
  conversationId String?
  contactName    String?
  note           String
  dueAt          DateTime
  status         String   @default("PENDING") // PENDING | DONE | CANCELLED
  firedAt        DateTime?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, dueAt])
  @@index([organizationId, status, dueAt])
}

/// One row per delivered weekly digest — the idempotency guard that prevents
/// duplicate sends ((userId, periodKey) is claimed before the email goes out).
model EmailDigest {
  id        String   @id @default(cuid())
  userId    String
  organizationId String?
  /// ISO week key, e.g. "2026-W24".
  periodKey String
  sentAt    DateTime @default(now())
  messageId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodKey])
  @@index([organizationId])
}

/// Invite-mode access requests. While the Gmail OAuth app is in Google Testing,
/// only Console "Test users" can connect, so a non-approved user submits the
/// mailbox they want to connect here; the owner is emailed and adds it manually.
/// `email` is unique so re-submits dedupe; `notifiedAt` is the notify-once guard.
model AccessRequest {
  id          String              @id @default(cuid())
  email       String              @unique
  note        String?
  status      AccessRequestStatus @default(PENDING)
  requestedBy String?
  notifiedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

enum JobType {
  GMAIL_SYNC
  ANALYZE_CONVERSATION
  EMBED_CONVERSATION
  SCAN_RISK_ALERTS
  SEND_WEEKLY_DIGEST
  GENERATE_DRAFT
  NOTIFY_ALERTS
  GMAIL_MAINTENANCE
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}
enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum IntegrationTypeEnum {
  TELEGRAM
  GMAIL
}
enum ChannelEnum {
  TELEGRAM
  GMAIL
}
enum ConversationStatus {
  ACTIVE
  ARCHIVED
  LOST
}
enum ConversationState {
  OPEN
  SNOOZED
  CLOSED
}
enum PriorityLevel {
  HOT
  ATTENTION
  COLD
  SPAM
}
enum EmailCategory {
  PRIMARY
  CLIENTS
  SERVICES
  PROMOTIONS
  NEWSLETTERS
  SPAM
}
enum MessageDirection {
  INBOUND
  OUTBOUND
}
enum ContentType {
  TEXT
  HTML
  ATTACHMENT
}
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}
enum AccessRequestStatus {
  PENDING
  APPROVED
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}
enum MemberStatus {
  ACTIVE
  SUSPENDED
}
enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}
enum BillingPlan {
  FREE
  TEAM
  BUSINESS
  ENTERPRISE
}
